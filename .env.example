# Entorno y origen. APP_ORIGIN debe ser HTTPS, puede incluir puerto y no puede incluir ruta.
DEPLOY_TARGET=private
COMPOSE_PROJECT_NAME=finanzas-hogar-dev
APP_ORIGIN=https://finanzas.example.internal:8446
APP_LOCAL_PORT=3100
FIREFLY_LOCAL_PORT=8081
TZ=America/Bogota

# PWA y API
PUBLIC_DATA_MODE=server
PUBLIC_API_BASE_URL=/api
PUBLIC_KEYCLOAK_URL=/auth
PUBLIC_KEYCLOAK_REALM=finanzas
PUBLIC_KEYCLOAK_CLIENT_ID=finanzas-web

# Persistencia aislada
POSTGRES_PASSWORD=GENERATE_ME
DATABASE_URL=postgresql://finanzas:GENERATE_ME@postgres:5432/finanzas
REDIS_URL=redis://redis:6379

# Hogar inicial; los MEMBER_*_ID deben reemplazarse por los sub de Keycloak.
HOUSEHOLD_ID=household-demo
HOUSEHOLD_NAME=Nuestro hogar
MEMBER_A_ID=member-a
MEMBER_A_NAME=Miembro A
MEMBER_A_EMAIL=member-a@example.invalid
MEMBER_B_ID=member-b
MEMBER_B_NAME=Miembro B
MEMBER_B_EMAIL=member-b@example.invalid

# Keycloak
KEYCLOAK_AUDIENCE=finanzas-api
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=GENERATE_ME
DEV_AUTH_ENABLED=false

# Firefly III
FIREFLY_BASE_URL=http://firefly:8080
FIREFLY_APP_KEY=GENERATE_ME
FIREFLY_HOUSEHOLD_TOKEN=
FIREFLY_PRIVATE_TOKEN_MEMBER_A=
FIREFLY_PRIVATE_TOKEN_MEMBER_B=

# AI-CFO
AI_CFO_URL=http://ai-cfo:8000
AI_CFO_INTERNAL_TOKEN=GENERATE_ME
AI_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
GEMINI_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Automatización. Se generan aunque el n8n incluido permanezca desactivado.
N8N_AUTOMATION_TOKEN=GENERATE_ME
N8N_ENCRYPTION_KEY=GENERATE_ME
# Web Push. init-env genera un par VAPID válido sin mostrarlo en pantalla.
VAPID_PUBLIC_KEY=GENERATE_ME
VAPID_PRIVATE_KEY=GENERATE_ME
