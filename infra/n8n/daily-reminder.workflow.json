{
  "name": "Procesar recordatorios Web Push",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "* * * * *" }]
        }
      },
      "id": "schedule-minute",
      "name": "Cada minuto",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [300, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.FINANZAS_API_URL}}/v1/automation/reminders/process",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-automation-token",
              "value": "={{$env.N8N_AUTOMATION_TOKEN}}"
            }
          ]
        },
        "options": { "response": { "response": { "responseFormat": "json" } } }
      },
      "id": "process-reminders",
      "name": "Procesar horarios pendientes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [560, 300]
    }
  ],
  "connections": {
    "Cada minuto": {
      "main": [
        [{ "node": "Procesar horarios pendientes", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "timezone": "America/Bogota",
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "none"
  },
  "active": false,
  "versionId": "a1c86768-4e33-4ed6-8372-e5f3f579188f"
}
